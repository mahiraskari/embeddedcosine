# Copy this file to .env and fill in the values. Never commit the real .env.
# Vite only reads these when the dev server or build starts, so restart after changing them.

# Your Supabase project URL and its public (anon / publishable) key,
# from Supabase > Project Settings > API. Never put the service_role / secret key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Where the backend API runs.
# Local development:  http://localhost:8000
# Production:         https://api.embeddedcosine.com
VITE_API_URL=http://localhost:8000
