# Copy this file to .env and fill in the values. Never commit the real .env.

# Your Supabase project URL (Supabase > Project Settings > API). Used to verify logins.
SUPABASE_URL=https://your-project-ref.supabase.co

# Which websites may call this API (comma-separated, no trailing slash).
# Local development:  http://localhost:5173
# Production:         https://embeddedcosine.com
FRONTEND_ORIGIN=http://localhost:5173

# Set to 1 when the API runs behind a reverse proxy (nginx, Azure, Cloudflare) so rate limiting
# sees each visitor's real IP instead of the proxy's. Leave 0 when running directly.
TRUST_PROXY=0
